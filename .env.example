# Neon pooled connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL=

# Optional: Neon direct connection for the Prisma CLI.
# Defaults to DATABASE_URL with "-pooler" removed from the host.
DIRECT_URL=

# Auth.js secret (generate with `npx auth secret`)
AUTH_SECRET=

# Public base URL of the app, used in verification and password reset links.
# Defaults to http://localhost:3000, so set it in production.
AUTH_URL=

# GitHub OAuth app
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend API key for verification and password reset emails
RESEND_API_KEY=

# Optional: sender address on a verified Resend domain.
# Defaults to "DevLore <onboarding@resend.dev>".
EMAIL_FROM=

# Email verification for email/password sign-up (on unless set to "false").
# Set to "false" while no domain is verified on Resend; new users are then marked verified.
EMAIL_VERIFICATION_ENABLED=

# Upstash Redis for rate limiting the auth flows (sign-in, sign-up, password reset, resend verification).
# Optional: without them, rate limiting is skipped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Toss Payments (billing). Test keys start with test_; live keys need a billing contract.
# Server secret key, never exposed to the browser
TOSS_SECRET_KEY=""
# Client key for the card registration window (the SDK calls it the client key)
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
# Optional: only if Toss signs BILLING_DELETED webhooks
TOSS_WEBHOOK_SECRET=""

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored billing keys.
# Changing it makes existing billing keys unreadable.
BILLING_KEY_SECRET=""

# Shared secret for /api/cron/billing (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# Plan limits (50 items, 3 collections, no File/Image) apply only when "true"
ENFORCE_PLAN_LIMITS=""
